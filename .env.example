# Turso database. Create one with:
#   turso db create sala-house-points
#   turso db show sala-house-points --url
#   turso db tokens create sala-house-points
TURSO_DATABASE_URL="libsql://your-database.turso.io"
TURSO_AUTH_TOKEN="your-token"

# Signs the access-code and admin session cookies. Any long random string.
# Generate one with:  openssl rand -base64 32
# Changing it signs everyone out, which is a useful way to revoke access.
APP_SECRET="replace-with-a-long-random-string"
